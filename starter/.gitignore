# Build outputs — regenerated by the GitHub Action (public/pdfs, public/) and by
# `nix run github:sc2in/policypress#serve` (static/pdfs). Never commit these:
# they are derived from content/ + config.toml on every build.
/public/
/static/pdfs/

# Stale intermediates from older toolchains / interrupted runs.
mermaid-filter.err
.pp-stamps-*/
